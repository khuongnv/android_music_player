<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>assets</key>
            <array>
                <dict>
                    <key>kind</key>
                    <string>software-package</string>
                    <!-- Đường dẫn HTTPS tải file IPA đã ký chứng chỉ VNPT Enterprise -->
                    <key>url</key>
                    <string>https://ota.your-server.vn/ios/MusicPlayer.ipa</string>
                </dict>
                <dict>
                    <key>kind</key>
                    <string>display-image</string>
                    <key>url</key>
                    <string>https://ota.your-server.vn/ios/icon_57x57.png</string>
                </dict>
                <dict>
                    <key>kind</key>
                    <string>full-size-image</string>
                    <key>url</key>
                    <string>https://ota.your-server.vn/ios/icon_512x512.png</string>
                </dict>
            </array>
            <key>metadata</key>
            <dict>
                <!-- Bundle Identifier khớp chính xác với Provisioning Profile VNPT -->
                <key>bundle-identifier</key>
                <string>com.dhtthni.dhxe</string>
                <key>bundle-version</key>
                <string>1.0.0</string>
                <key>kind</key>
                <string>software</string>
                <key>title</key>
                <string>Music Player</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>

